[user]
	name = Ed Chapman
	email = edchapman88@gmail.com
{{- if .gpg_signing_key }}
	signingkey = {{ .gpg_signing_key }}
{{- end }}
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[core]
	ignorecase = false
	autocrlf = input
	hooksPath = ~/.config/git/hooks
{{- if and .gpg_signing_key (stat "/usr/local/bin/gpg") }}
[commit]
	gpgsign = true
[gpg]
	# Pin GPG Suite (MacGPG2) explicitly. `lookPath "gpg"` baked in whichever gpg
	# was first on the render-time PATH (Homebrew gnupg vs GPG Suite), so
	# ~/.gitconfig phantom-drifted depending on where chezmoi was rendered. Gating
	# on stat of this path is PATH-independent — deterministic across environments.
	program = /usr/local/bin/gpg
{{- end }}
[alias]
	# Squash-merge-aware sync. After a squash-merge the original branch isn't an
	# ancestor of the default branch, so `--merged` doesn't catch it; the
	# `[gone]`-upstream prune (step 2) handles those. The awk filter skips the
	# currently-checked-out branch ($1 == "*") so the pipeline can't delete the
	# current HEAD. The default branch is derived from origin/HEAD (falling back
	# to the current branch) so this works in main- and master-based repos alike
	# — sync is a global alias run in every repo.
	sync = "!f() { \
		d=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'); \
		git fetch --all --prune && \
		git branch -vv | awk '/: gone]/ && $1 != \"*\" {print $1}' | xargs -r -n1 git branch -D; \
		git pull --ff-only --autostash && \
		git branch --merged \"${d:-HEAD}\" | grep -vE '^\\*|^\\s*(main|master)$' | xargs -r -n1 git branch -d; \
	}; f"
[credential "https://github.com"]
	helper =
	helper = !{{ includeTemplate "brew-prefix" . }}/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !{{ includeTemplate "brew-prefix" . }}/bin/gh auth git-credential
